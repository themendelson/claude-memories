{
  "name": "claude-memories",
  "version": "0.1.0",
  "description": "See, search and delete every memory Claude Code has saved on your machine",
  "keywords": [
    "claude",
    "claude-code",
    "memory",
    "memories",
    "auto-memory",
    "viewer",
    "cli"
  ],
  "license": "MIT",
  "author": "Amir Mendelson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themendelson/claude-memories.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.8.1",
  "files": [
    "dist"
  ],
  "bin": {
    "claude-memories": "dist/cli.js"
  },
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsdown",
    "start": "node dist/cli.js",
    "lint": "biome check . && oxlint --type-aware && knip && jscpd",
    "format": "biome check --write .",
    "typecheck": "tsc",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "prepublishOnly": "pnpm check && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "oxc-parser": "0.154.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "unrun": "0.3.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
